    <!-- Step 1: Bedroom <-> KidsRoom divider (E-W wall along y).
         Solid segment at y=-1.21, spanning x in [-9.4, -2.5]. -->
    <model name='Bedroom_South_Divider'>
      <static>true</static>
      <pose>-5.95 -1.21 1.25 0 0 0</pose>
      <link name='link'>
        <collision name='collision'>
          <geometry><box><size>6.9 0.1 2.5</size></box></geometry>
        </collision>
        <visual name='visual'>
          <geometry><box><size>6.9 0.1 2.5</size></box></geometry>
          <material>
            <ambient>0.9 0.88 0.82 1</ambient>
            <diffuse>0.9 0.88 0.82 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Step 2: LivingRoom <-> Bedroom/KidsRoom divider (N-S wall along x=-2.55).
         Four segments + two 1.0m doorway gaps:
           - Bedroom door gap centered at y=+0.10 (between Bedroom_East_North and Bedroom_East_South)
           - Kids room door gap centered at y=-3.41 (between KidsRoom_East_North and KidsRoom_East_South) -->

    <model name='Bedroom_East_North'>
      <static>true</static>
      <pose>-2.55 1.05 1.25 0 0 0</pose>
      <link name='link'>
        <collision name='collision'>
